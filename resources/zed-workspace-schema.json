{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fu5ha/zed-workspaces/main/resources/zed-workspace-schema.json",
  "title": "Zed Workspace",
  "type": "object",
  "properties": {
    "folders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "uri": { "type": "string" }
        },
        "anyOf": [
          { "required": ["path"] },
          { "required": ["uri"] }
        ],
        "additionalProperties": true
      }
    },
    "settings": {
      "$ref": "zed://schemas/settings"
    },
    "debug": {
      "type": "array",
      "items": {
        "$ref": "zed://schemas/debug"
      }
    }
  },
  "required": ["folders"],
  "additionalProperties": true
}
